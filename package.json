{
  "name": "bidflow",
  "version": "0.0.0",
  "private": true,
  "description": "BidFlow: real-time auction platform (portfolio / demo project, simulated bids only)",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev:api": "node --watch --env-file-if-exists=.env apps/api/src/server.ts",
    "start:api": "node --env-file-if-exists=.env apps/api/src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-reporter=spec \"apps/**/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "test:integration": "node scripts/test-integration.ts",
    "check:infra": "node --env-file-if-exists=.env scripts/check-infra.ts",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "infra:reset": "docker compose --env-file .env -f infra/compose.yaml down --volumes",
    "dev:web": "vite apps/web",
    "build:web": "vite build apps/web",
    "test:e2e": "node scripts/test-integration.ts --e2e",
    "test:cluster": "node scripts/test-cluster.ts",
    "cluster:up": "node --env-file-if-exists=.env scripts/cluster.ts up",
    "cluster:down": "node --env-file-if-exists=.env scripts/cluster.ts down"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
