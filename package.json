{
  "name": "bidflow",
  "version": "0.0.0",
  "private": true,
  "description": "BidFlow: real-time auction platform (portfolio / demo project, simulated bids only)",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev:api": "node --watch --env-file-if-exists=.env apps/api/src/server.ts",
    "start:api": "node --env-file-if-exists=.env apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-reporter=spec \"apps/**/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "test:integration": "node scripts/test-integration.ts",
    "check:infra": "node --env-file-if-exists=.env scripts/check-infra.ts",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "infra:reset": "docker compose --env-file .env -f infra/compose.yaml down --volumes"
  },
  "dependencies": {
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
