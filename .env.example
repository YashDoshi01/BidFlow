# Copy to .env and edit. .env is git-ignored. Never commit real values.
# Every value below is a local-development placeholder, not a secret.

NODE_ENV=development
LOG_LEVEL=info

# --- API process ---
API_PORT=3000
# How long a login session stays valid, in hours (default 168 = 7 days, max 720).
SESSION_TTL_HOURS=168

# --- Docker Compose (infra/compose.yaml) ---
# Host ports are deliberately unusual so they do not collide with a
# PostgreSQL/Redis you already run locally. Containers bind 127.0.0.1 only.
POSTGRES_USER=bidflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=bidflow
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# --- Connection strings used by the app (must match the values above) ---
DATABASE_URL=postgres://bidflow:change-me-local-only@127.0.0.1:55432/bidflow
REDIS_URL=redis://127.0.0.1:56379

# --- API process (optional) ---
# API_HOST=127.0.0.1        # interface to listen on; loopback by default (the container stack uses 0.0.0.0)
# INSTANCE_ID=api1          # names this instance in logs and the X-Instance-Id header (default hostname-pid)

# --- Outbox worker (optional; `npm run dev:worker`; the API ignores these) ---
# OUTBOX_POLL_INTERVAL_MS=100   # sleep when there is nothing to publish
# OUTBOX_BATCH_SIZE=50          # events claimed per cycle (at most one per auction)
# OUTBOX_LEASE_SECONDS=30       # a claimed event not finished by then is taken over by another worker
# OUTBOX_MAX_ATTEMPTS=10        # failed attempts before an event is FAILED and needs a manual retry
# OUTBOX_RETENTION_HOURS=168    # published events older than this are deleted

# --- Lifecycle worker (optional; `npm run dev:lifecycle`; the API ignores these) ---
# LIFECYCLE_POLL_INTERVAL_MS=1000   # sleep when nothing is due; the worst-case delay between ends_at and the ending
# LIFECYCLE_BATCH_SIZE=50           # auctions handled per kind (start, end, ending soon) per pass
# ENDING_SOON_SECONDS=300           # "ending soon" notifications are written when an auction is this close to its end

# --- Web dev server (optional) ---
# `npm run dev:web` reads these from the SHELL environment, not from .env, and has defaults.
# API_URL=http://127.0.0.1:3000
# WEB_PORT=5173
