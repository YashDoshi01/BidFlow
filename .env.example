# Copy to .env and edit. .env is git-ignored. Never commit real values.
# Every value below is a local-development placeholder, not a secret.

NODE_ENV=development
LOG_LEVEL=info

# --- API process ---
API_PORT=3000

# --- Docker Compose (infra/compose.yaml) ---
# Host ports are deliberately unusual so they do not collide with a
# PostgreSQL/Redis you already run locally. Containers bind 127.0.0.1 only.
POSTGRES_USER=bidflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=bidflow
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# --- Connection strings used by the app (must match the values above) ---
DATABASE_URL=postgres://bidflow:change-me-local-only@127.0.0.1:55432/bidflow
REDIS_URL=redis://127.0.0.1:56379
